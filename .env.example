# ------------------------------------------------------------------
# Copia este archivo como .env  (PowerShell: Copy-Item .env.example .env)
# Los valores son FICTICIOS y solo sirven para el equipo local.
# .env está en .gitignore: nunca se sube a GitHub.
# ------------------------------------------------------------------

# Nombre del proyecto Compose: prefijo de contenedores, red y volúmenes
COMPOSE_PROJECT_NAME=mensajeria

# API y web (http://localhost:3000)
API_PORT=3000
NODE_ENV=development

# PostgreSQL: envíos, catálogos, despacho, outbox
POSTGRES_DB=mensajeria
POSTGRES_USER=mensajeria_app
POSTGRES_PASSWORD=cambia_esta_clave_local
# Puerto publicado SOLO en 127.0.0.1 (para DBeaver)
POSTGRES_HOST_PORT=5432

# MongoDB: eventos de seguimiento y evidencias
MONGO_INITDB_ROOT_USERNAME=mensajeria_admin
MONGO_INITDB_ROOT_PASSWORD=cambia_esta_clave_local
MONGO_DB=mensajeria
# 27018 porque algunos equipos ya tienen MongoDB de Windows en 27017
MONGO_HOST_PORT=27018

# Redis: estado temporal de repartidores (con expiración)
REDIS_PASSWORD=cambia_esta_clave_local
REDIS_HOST_PORT=6379
